AUTH_PORT=3012
AUTH_HOST=127.0.0.1
# Usar el mismo secreto que OptiClean para tokens compartidos
AUTH_JWT_SECRET=
OPTICLEAN_JWT_SECRET=
AUTH_JWT_TTL=43200
AUTH_ISSUER=innovamf-auth
AUTH_DB_PATH=../data/auth/auth-db.json
OPTICLEAN_USERS_PATH=../data/users.json
AUTH_EXPOSE_RESET_LINK=1
AUTH_RESET_BASE_URL=https://opti.innovamf.com/restablecer
AUTH_RESET_TTL_MIN=30
AUTH_MIN_PASSWORD_LENGTH=8
NODE_ENV=production
